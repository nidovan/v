<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Collaboration portal tour</title>
  <style>
    :root {
      font-family: "Segoe UI", system-ui, sans-serif;
      color: #18212b;
      --border: #d9e0e7;
      --action: linear-gradient(105deg, #00649a, #1043a9);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: 1.25rem;
      background: #f3f6f8;
    }

    .tour {
      display: none;
      width: min(100%, 32rem);
      padding: clamp(1.25rem, 5vw, 2rem);
      border: 1px solid var(--border);
      border-radius: 1rem;
      background: linear-gradient(135deg, #dcecf6 0%, #f5f8fc 52%, #ebe2f3 100%);
      box-shadow: 0 18px 48px #20344719, 0 2px 8px #2034470d;
    }

    #tour-start, .tour:target, #tour-closed:target { display: block; }
    #tour-closed { display: none; }

    body:has(.tour:target, #tour-closed:target) #tour-start:not(:target) {
      display: none;
    }

    .flex { display: flex; }
    .items-center { align-items: center; }
    .justify-between { justify-content: space-between; }
    .gap-3 { gap: .75rem; }
    .text-sm { font-size: .875rem; }

    .step {
      padding: .3rem .75rem;
      border: 1px solid #d6e2ec;
      border-radius: 999px;
      background: #f4f8fb;
      color: #31516b;
      font-weight: 600;
    }

    .progress {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: .375rem;
      margin: .875rem 0 1.5rem;
    }

    .progress span {
      height: 4px;
      border-radius: 999px;
      background: #dfe6ee;
    }

    .progress .active { background: var(--action); }

    h1 {
      margin: 0;
      font-size: clamp(1.4rem, 5vw, 1.75rem);
      line-height: 1.2;
      font-weight: 650;
      letter-spacing: -.025em;
    }

    p {
      margin: .75rem 0 1.5rem;
      color: #435160;
      line-height: 1.55;
    }

    .actions { flex-wrap: wrap; }

    .button, .close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      text-decoration: none;
    }

    .button {
      padding: .625rem 1rem;
      border-radius: .75rem;
      font-weight: 600;
    }

    .primary { background: var(--action); color: #fff; }
    .primary:hover { background: #10438e; }

    .secondary {
      background: #ffffffb3;
      border: 1px solid var(--border);
      color: #253445;
    }

    .close {
      width: 44px;
      border-radius: 50%;
      color: #425263;
      font-size: 1.4rem;
    }

    .secondary:hover, .close:hover { background: #e9f0f5; }
    :focus-visible { outline: 3px solid #2768bc; outline-offset: 3px; }
  </style>
</head>
<body>
  <section class="tour" id="tour-start" aria-labelledby="start-title" tabindex="-1">
    <header class="flex items-center justify-between gap-3">
      <span class="step text-sm">Step 1 of 3</span>
      <a class="close" href="#tour-closed" aria-label="Close tour">×</a>
    </header>
    <div class="progress" aria-hidden="true">
      <span class="active"></span><span></span><span></span>
    </div>
    <h1 id="start-title">Find the right collaboration tool</h1>
    <p>Choose a suggested activity, such as collaborating on documents or building a community.</p>
    <nav class="actions flex justify-between gap-3 text-sm" aria-label="Tour navigation">
      <a class="button secondary" href="#tour-closed">Skip tour</a>
      <a class="button primary" href="#tour-modes">Next&nbsp;<span aria-hidden="true">→</span></a>
    </nav>
  </section>

  <section class="tour" id="tour-modes" aria-labelledby="modes-title" tabindex="-1">
    <header class="flex items-center justify-between gap-3">
      <span class="step text-sm">Step 2 of 3</span>
      <a class="close" href="#tour-closed" aria-label="Close tour">×</a>
    </header>
    <div class="progress" aria-hidden="true">
      <span class="active"></span><span class="active"></span><span></span>
    </div>
    <h1 id="modes-title">Choose Classic or AI</h1>
    <p>Use Classic to browse the catalog, or switch to AI (beta) to describe what you need in your own words.</p>
    <nav class="actions flex justify-between gap-3 text-sm" aria-label="Tour navigation">
      <a class="button secondary" href="#tour-start">Back</a>
      <a class="button primary" href="#tour-products">Next&nbsp;<span aria-hidden="true">→</span></a>
    </nav>
  </section>

  <section class="tour" id="tour-products" aria-labelledby="products-title" tabindex="-1">
    <header class="flex items-center justify-between gap-3">
      <span class="step text-sm">Step 3 of 3</span>
      <a class="close" href="#tour-closed" aria-label="Close tour">×</a>
    </header>
    <div class="progress" aria-hidden="true">
      <span class="active"></span><span class="active"></span><span class="active"></span>
    </div>
    <h1 id="products-title">Compare and create</h1>
    <p>Review the features on each product card. When you’ve found the right fit, select its blue Create button.</p>
    <nav class="actions flex justify-between gap-3 text-sm" aria-label="Tour navigation">
      <a class="button secondary" href="#tour-modes">Back</a>
      <a class="button primary" href="#tour-closed">Finish tour</a>
    </nav>
  </section>

  <div id="tour-closed" tabindex="-1">
    <a class="button primary text-sm" href="#tour-start">Start tour</a>
  </div>
</body>
</html>
